{
  "name": "3js-test-harness",
  "private": true,
  "license": "MIT",
  "description": "Regression tests for The Vanishing Gallery (ghanemja/art-heist): story, interactions, models, static checks",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node tests/run.mjs",
    "test:static": "node tests/run.mjs static",
    "test:story": "node tests/run.mjs story",
    "test:interactions": "node tests/run.mjs interactions",
    "test:models": "node tests/run.mjs models",
    "baseline": "UPDATE_BASELINE=1 node --test tests/models.test.mjs"
  },
  "devDependencies": { "playwright": "^1.48.0" }
}
